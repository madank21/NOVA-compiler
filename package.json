{
  "name": "nova-studio-compiler",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:engine && npm run test:parity",
    "test:engine": "node tests/run_engine_test.mjs",
    "test:parity": "node tests/parity_test.mjs",
    "test:c-backend": "cd c_backend && make check",
    "test:all": "npm run test:engine && npm run test:c-backend && npm run test:parity",
